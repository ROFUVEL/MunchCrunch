@startuml
skinparam classAttributeIconSize 0

' =========================
' ADAPTER LAYER
' =========================
class DatabaseAdapter {
  +getUserByPhone(phone)
  +createClient(phone)
  +getUserById(id)

  +getMenu()

  +getBranches()

  +createOrder(userId, branchId, totalPrice)
  +addOrderItem(orderId, dishId, quantity)
  +getUserOrders(userId)
}

' =========================
' FACADE LAYER
' =========================
class AuthFacade {
  +login(phone)
}

class MenuFacade {
  +getMenu()
}

class OrderFacade {
  +createOrder(userId, branchId, items)
  +getUserOrders(userId)
}


class BranchFacade {
  +getBranches()
}


' =========================
' RELATIONS (Facade -> Adapter)
' =========================
AuthFacade --> DatabaseAdapter
MenuFacade --> DatabaseAdapter
OrderFacade --> DatabaseAdapter
BranchFacade --> DatabaseAdapter

' =========================
' DOMAIN ENTITIES (DB TABLES)
' =========================
class User {
  +id
  +phone
}

class Order {
  +id
  +user_id
  +branch_id
  +status
  +total_price
  +created_at
}

class OrderItem {
  +order_id
  +dish_id
  +quantity
}

class Dish {
  +id
  +name
  +description
  +price
  +category_id
  +is_available
}

class Branch {
  +id
  +name
  +address
  +work_hours
}

' =========================
' RELATIONS (DB)
' =========================
User "1" --> "*" Order
Order "1" --> "*" OrderItem
OrderItem "*" --> "1" Dish
Order "*" --> "1" Branch

@enduml
